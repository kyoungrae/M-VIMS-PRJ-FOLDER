<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vims.common.bbs.SysBbsReplyMapper">
    <sql id="sortFilter">
        ORDER BY
        <choose>
            <when test="sort_id != null and sort_order != null">
                ${sort_id} ${sort_order}
            </when>
            <otherwise>
                sys_crt_dt ASC
            </otherwise>
        </choose>
    </sql>

    <sql id="replyColumns">
        cmnt_id AS cmnt_id,
        pst_id AS pst_id,
        prnt_cmnt_id AS prnt_cmnt_id,
        cn AS cn,
        wrtr_nm,
        sys_crt_usr_id,
        sys_gen_dt AS sys_crt_dt,
        sys_mdfr_id AS sys_upd_usr_id,
        sys_mdfcn_dt AS sys_upd_dt
    </sql>

    <sql id="replyWhere">
        <where>
            <if test="cmnt_id != null and cmnt_id != ''">AND cmnt_id = #{cmnt_id}</if>
            <if test="pst_id != null and pst_id != ''">AND pst_id = #{pst_id}</if>
            <if test="prnt_cmnt_id != null and prnt_cmnt_id != ''">AND prnt_cmnt_id = #{prnt_cmnt_id}</if>
            <if test="_cn != null and _cn != ''">AND cn LIKE CONCAT('%', #{_cn}, '%')</if>
            <if test="_wrtr_nm != null and _wrtr_nm != ''">AND wrtr_nm LIKE CONCAT('%', #{_wrtr_nm}, '%')</if>
        </where>
    </sql>

    <select id="SELECT_PAGE" resultType="com.vims.common.bbs.SysBbsReply">
        SELECT * FROM (
            SELECT
                row_number() over (ORDER BY sys_gen_dt ASC) AS no,
                <include refid="replyColumns"/>
            FROM SYS_BBS_CMNT
            <include refid="replyWhere"/>
        ) AS sub
        <include refid="sortFilter"/>
        <if test="row_range != null and offset != null">
            LIMIT #{row_range} OFFSET #{offset}
        </if>
    </select>

    <select id="SELECT_PAGING_TOTAL_NUMBER" resultType="int">
        SELECT CEIL(COUNT(*) / #{row_range}) FROM SYS_BBS_CMNT
        <include refid="replyWhere"/>
    </select>

    <select id="SELECT" resultType="com.vims.common.bbs.SysBbsReply">
        SELECT
            <include refid="replyColumns"/>
        FROM SYS_BBS_CMNT
        <include refid="replyWhere"/>
    </select>

    <!-- 게시물 ID로 댓글 목록 조회 (계층 구조 정렬: 부모 댓글 먼저, 그 아래 대댓글) -->
    <select id="SELECT_BY_BOARD_ID" resultType="com.vims.common.bbs.SysBbsReply">
        SELECT
            <include refid="replyColumns"/>
        FROM SYS_BBS_CMNT
        WHERE pst_id = #{pst_id}
        ORDER BY
            COALESCE(prnt_cmnt_id, cmnt_id) ASC,
            prnt_cmnt_id IS NOT NULL ASC,
            sys_gen_dt ASC
    </select>

    <!-- 게시물별 댓글 수 조회 -->
    <select id="COUNT_BY_BOARD_ID" resultType="int">
        SELECT COUNT(*) FROM SYS_BBS_CMNT WHERE pst_id = #{pst_id}
    </select>

    <insert id="INSERT">
        INSERT INTO SYS_BBS_CMNT(
            cmnt_id, pst_id, prnt_cmnt_id, cn, wrtr_nm,
            sys_crt_usr_id, sys_gen_dt, sys_mdfr_id, sys_mdfcn_dt
        )
        VALUES(
            #{cmnt_id}, #{pst_id}, #{prnt_cmnt_id}, #{cn}, #{wrtr_nm},
            #{sys_crt_usr_id}, NOW(), #{sys_upd_usr_id}, NOW()
        )
    </insert>

    <update id="UPDATE">
        UPDATE SYS_BBS_CMNT
        <set>
            <if test="cn != null">cn = #{cn},</if>
            <if test="wrtr_nm != null">wrtr_nm = #{wrtr_nm},</if>
            sys_mdfr_id = #{sys_upd_usr_id},
            sys_mdfcn_dt = NOW()
        </set>
        <where>
            AND cmnt_id = #{cmnt_id}
        </where>
    </update>

    <delete id="DELETE">
        DELETE FROM SYS_BBS_CMNT
        WHERE cmnt_id = #{cmnt_id} OR prnt_cmnt_id = #{cmnt_id}
    </delete>
</mapper>
